# EduHub – Environment variables
# Copy to .env and fill in values. Never commit .env.

# Environment 
# dev  = auto-reload, seeded demo courses, next dev
# prod = uvicorn workers, no seeding, built frontend
ENVIRONMENT=dev

# Comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1

# true (seeds demo data)
ENABLE_POPULATE_DB=true

# PostgreSQL 
POSTGRES_DB=eduhub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS / Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Linux only: your user/group id (`id -u` / `id -g`) if not 1000, so the frontend and API
# containers can write into their mounted folders. Not needed on Windows/macOS.
# HOST_UID=1000
# HOST_GID=1000

# Better Auth (login, sessions, Google sign-in) runs in the Next.js app
# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Public URL of the frontend; also the issuer/audience the API checks in tokens
BETTER_AUTH_URL=http://localhost:5173
# Required. Shared by the Next.js server and the API only, for calls no user makes (removing a deleted
# account's data). Generate with: openssl rand -base64 32
INTERNAL_API_SECRET=change-me-too
# Optional: comma-separated emails of the moderators who handle reports (the /moderation page)
ADMIN_EMAILS=
# Optional: error tracking for the API (Sentry, or a compatible service such as GlitchTip)
SENTRY_DSN=
# Optional: multiplies the sign-in/sign-up rate limits (keep 1 in production; the end-to-end tests use 50)
# AUTH_RATE_LIMIT_SCALE=1
# Optional: Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application").
# Authorized redirect URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (sign-up confirmation links). Docker Compose defaults to the bundled Mailpit
# (inbox at http://localhost:8025), so leave these empty locally. In production use any SMTP
# provider, e.g. Brevo's free tier (300 emails/day): SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=EduHub <no-reply@your-domain.com>

# API base URL for frontend (no /api suffix – appended in code)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Uploaded course images (optional; default Backend/media)
# MEDIA_ROOT=/app/media
